# AK Media India - Environment Configuration
# Copy this file to .env and update values

# Server Configuration
PORT=3000
NODE_ENV=development

# API base URL consumed by the typed client (lib/api/client.ts)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8080

# Database Configuration (for production)
DATABASE_URL=postgresql://username:password@localhost:5432/akmedia
MONGODB_URI=mongodb://localhost:27017/akmedia

# Redis for caching/sessions
REDIS_URL=redis://localhost:6379

# Email Service (Nodemailer)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-email@example.com
MAIL_PASS=your-email-password
MAIL_FROM=noreply@akmediaindia.com

# API Keys
CLOUDINARY_URL=cloudinary://api_key:api_secret
STRIPE_SECRET_KEY=your-stripe-secret-key

# Analytics
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
SENCHA_DSN=your-sentry-dsn

# Security
JWT_SECRET=your-jwt-secret-key
ENCRYPTION_KEY=your-encryption-key